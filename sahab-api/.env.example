CORS_ORIGINS=http://localhost:3000,https://sahab-ai.vercel.app
RESULTS_DIR=./results
MAX_CONCURRENT_RUNS=2
GEMINI_API_KEY=your_gemini_key_here
# Models are configurable because Google retires them (gemini-2.0-flash is already shut down)
GEMINI_INTENT_MODEL=gemini-3.1-flash-lite
GEMINI_INSIGHT_MODEL=gemini-3.8-flash
