CORS_ORIGINS=http://localhost:3000,https://sahab-ai.vercel.app
RESULTS_DIR=./results
MAX_CONCURRENT_RUNS=2
# Public URL of this API, used to build links to generated maps (defaults to the request URL)
PUBLIC_BASE_URL=
GEMINI_API_KEY=your_gemini_key_here
GEMINI_INTENT_MODEL=gemini-flash-latest
GEMINI_INSIGHT_MODEL=gemini-flash-latest
# used only when the primary model is overloaded or too slow
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
